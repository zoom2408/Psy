---
import { render } from 'astro:content';
import CourseLayout from '../../layouts/CourseLayout.astro';
import Callout from '../../design-system/components/Callout.astro';
import Quiz from '../../design-system/components/Quiz.astro';
import QuizSet from '../../design-system/components/QuizSet.astro';
import Flashcard from '../../design-system/components/Flashcard.astro';
import { courses } from '../../data/courses';
import { notesOf } from '../../lib/vault';

export async function getStaticPaths() {
  const out = [];
  for (const course of courses.filter((c) => c.ready)) {
    for (const note of await notesOf(course.slug)) out.push({ params: { course: course.slug, page: note.data.slug }, props: { course, note } });
    if (course.cards || course.quiz) out.push({ params: { course: course.slug, page: 'on-tap' }, props: { course, note: null } });
  }
  return out;
}
const { course, note } = Astro.props;
const mod = note ? (course.modules ?? []).find((m) => m.id === note.data.slug) : undefined;
const rendered = note ? await render(note) : null;
const Content = rendered?.Content;
const headings = rendered
  ? rendered.headings.filter((h) => h.depth <= 3 && !/^Câu \d+/.test(h.text))
  : [{ depth: 2, slug: 'flashcard', text: 'Flashcard' }, { depth: 2, slug: 'quiz', text: 'Quiz khởi động' }];
const title = note?.data.title ?? 'Ôn tập nhanh';
---
<CourseLayout course={course} pageId={note?.data.slug ?? 'on-tap'} title={title} headings={headings}
  description={mod ? mod.lead : note ? `${title}, môn ${course.title}.` : `Flashcard và quiz ôn nhanh ${course.title}.`}>
  {Content ? (
    <>
      <h1>{title}</h1>
      {mod && <p class="cdoc__lead">{mod.lead}</p>}
      {note.data.status === 'draft' && <Callout type="note" title="Bản nháp">Nội dung được chuyển tự động từ tài liệu cũ, đang chờ rà soát.</Callout>}
      <div class="vault"><Content /></div>
    </>
  ) : (
    <>
      <h1>Ôn tập nhanh</h1>
      <p class="cdoc__lead">Lật thẻ để nhớ các mốc thời gian và làm vài câu quiz để kiểm tra.</p>
      {course.cards && (
        <>
          <h2 id="flashcard">Flashcard</h2>
          <p>Nhấn vào thẻ để xem đáp án. Đánh dấu thẻ nào còn lúng túng.</p>
          <div class="cdoc__cards">
            {course.cards.map((c) => <Flashcard label={c.label}><p>{c.front}</p><p slot="back">{c.back}</p></Flashcard>)}
          </div>
        </>
      )}
      {course.quiz && (
        <>
          <h2 id="quiz">Quiz khởi động</h2>
          <QuizSet title={`Khởi động ${course.title}`}>
            {course.quiz.map((item, i) => <Quiz number={i + 1} {...item} />)}
          </QuizSet>
        </>
      )}
    </>
  )}
</CourseLayout>
<script>import '../../scripts/quiz.ts';</script>
