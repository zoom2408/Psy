  .ds__swatches { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .sw { position: relative; display: grid; gap: 2px; width: 5.25rem; padding: var(--space-1); text-align: left; background: var(--color-bg-surface); border: 1px solid var(--color-border-subtle); border-radius: var(--radius-md); transition: transform var(--duration-fast) var(--ease-spring), box-shadow var(--duration-base), border-color var(--duration-fast); }
