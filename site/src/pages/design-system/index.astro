  .ds kbd { font-family: var(--font-mono); font-size: 0.8em; padding: 0.05em 0.4em; border: 1px solid var(--color-border-default); border-bottom-width: 2px; border-radius: var(--radius-sm); background: var(--color-bg-surface); }
  .ds__sec > .spec, .ds__sec > .ds__cols { margin-bottom: var(--space-5); }

  .ds__cols { display: grid; gap: var(--space-4); grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); align-items: start; }
  .ds__cols--2 { grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); }
  .ds__card { padding: var(--space-5); background: var(--color-bg-surface); border: 1px solid var(--color-border-default); border-radius: var(--radius-lg); }
