  .ds__font { margin-bottom: var(--space-2); font-size: var(--text-2xl); font-weight: var(--weight-semibold); }

  /* bảng */
  .ds__table-wrap { overflow-x: auto; border: 1px solid var(--color-border-default); border-radius: var(--radius-lg); background: var(--color-bg-surface); margin-bottom: var(--space-4); }
