<script>
  // Chép tên biến khi bấm ô màu
  document.querySelectorAll('[data-copy]').forEach((b) => {
    b.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(b.dataset.copy); } catch {}
      b.setAttribute('data-copied', '');
      setTimeout(() => b.removeAttribute('data-copied'), 1100);
    });
  });

  // Phát lại demo chuyển động
  document.querySelectorAll('.mo').forEach((row) => {
    const track = row.querySelector('.mo__track');
    row.querySelector('[data-play]').addEventListener('click', () => {
      track.style.setProperty('--track-w', track.clientWidth + 'px');
      track.classList.remove('is-on');
      void track.offsetWidth;
      requestAnimationFrame(() => track.classList.add('is-on'));
      setTimeout(() => track.classList.remove('is-on'), 1300);
    });
  });

  // Nguồn dữ liệu giả lập cho SearchBox (thay bằng chỉ mục thật sau)
  const index = [
    { title: 'Cơ chế phòng vệ', href: '#', course: 'Nhân cách', excerpt: 'Chiến lược vô thức giúp Ego giảm lo âu.' },
    { title: 'Cơ chế bù trừ', href: '#', course: 'Nhân cách', excerpt: 'Adler: nỗ lực vượt qua mặc cảm tự ti.' },
    { title: 'Trí nhớ làm việc', href: '#', course: 'Nhận thức', excerpt: 'Hệ thống lưu giữ và xử lý thông tin tạm thời.' },
    { title: 'ANOVA', href: '#', course: 'Thống kê', excerpt: 'So sánh trung bình của từ ba nhóm trở lên.' },
    { title: 'Rối loạn lo âu', href: '#', course: 'Tâm bệnh học' }
  ];
  const norm = (s) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/đ/g, 'd');
  document.querySelectorAll('psy-search').forEach((el) => {
    if (el.querySelector('input').id === 'x' || el.dataset.open === 'true') return;
    el.addEventListener('psy-search:query', (e) => {
      const q = norm(e.detail.query);
      el.setState('loading');
      setTimeout(() => {
        if (q === 'loi') return el.setState('error');
        el.setResults(index.filter((r) => norm(r.title).includes(q)));
      }, 450);
    });
  });
</script>
