---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<footer class="ft">
  <div class="ft__in">
    <span>Psy, wiki cử nhân Tâm lý</span>
    <nav aria-label="Chân trang"><a href={`${base}/#mon-hoc`}>Môn học</a><a href={`${base}/bai-viet/`}>Bài viết</a><a href={`${base}/design-system/`}>Design system</a></nav>
  </div>
</footer>
<style is:global>
  .ft { margin-top: var(--space-16); padding-block: var(--space-6); border-top: 1px solid var(--color-border-subtle); font-family: var(--font-sans); font-size: var(--text-sm); color: var(--color-text-muted); }
  .ft__in { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-3); max-width: var(--layout-container); margin-inline: auto; padding-inline: var(--layout-gutter); }
  .ft nav { display: flex; gap: var(--space-5); }
  .ft a { color: inherit; text-underline-offset: 3px; }
  .ft a:hover { color: var(--accent-text); }
  .ft a:focus-visible { outline: 2px solid var(--accent-solid); outline-offset: 2px; border-radius: var(--radius-sm); }
</style>
