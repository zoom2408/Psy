---
// Điều hướng bài trước / bài sau. States: default, hover (mũi tên trượt, nâng lên), focus, active, thiếu một phía (ô trống).
import Icon from './Icon.astro';
interface Link { title: string; href: string }
interface Props { prev?: Link; next?: Link }
const { prev, next } = Astro.props;
---
<nav class="pn" aria-label="Chuyển bài">
  {prev ? (
    <a class="pn__card pn__card--prev" href={prev.href} rel="prev">
      <span class="pn__dir"><Icon name="arrow-left" size={16} class="pn__arrow" /> Bài trước</span>
      <span class="pn__title">{prev.title}</span>
    </a>
  ) : <span class="pn__gap" aria-hidden="true"></span>}
  {next ? (
    <a class="pn__card pn__card--next" href={next.href} rel="next">
      <span class="pn__dir">Bài sau <Icon name="arrow-right" size={16} class="pn__arrow" /></span>
      <span class="pn__title">{next.title}</span>
    </a>
  ) : <span class="pn__gap" aria-hidden="true"></span>}
</nav>

<style is:global>
  .pn { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4); max-width: var(--layout-measure); margin-top: var(--space-12); font-family: var(--font-sans); }
  .pn__card {
    display: flex; flex-direction: column; gap: var(--space-1); padding: var(--space-4) var(--space-5);
    background: var(--color-bg-surface); border: 1px solid var(--color-border-default); border-radius: var(--radius-lg);
    color: inherit; text-decoration: none; box-shadow: var(--shadow-sm);
    transition: transform var(--duration-base) var(--ease-spring), box-shadow var(--duration-base), border-color var(--duration-fast), background-color var(--duration-fast);
  }
  .pn__card--next { text-align: right; align-items: flex-end; }
  .pn__card:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); border-color: var(--accent-solid); background: var(--accent-tint); }
  .pn__card:active { transform: scale(0.985); box-shadow: none; transition-duration: var(--duration-instant); }
  .pn__card:focus-visible { outline: 2px solid var(--accent-solid); outline-offset: 2px; border-radius: var(--radius-lg); }
  .pn__dir { display: inline-flex; align-items: center; gap: var(--space-1); font-size: var(--text-xs); font-weight: var(--weight-medium); color: var(--color-text-muted); }
  .pn__arrow { transition: transform var(--duration-base) var(--ease-spring); }
  .pn__card--next:hover .pn__arrow { transform: translateX(4px); }
  .pn__card--prev:hover .pn__arrow { transform: translateX(-4px); }
  .pn__title { font-family: var(--font-serif); font-size: var(--text-md); font-weight: var(--weight-semibold); line-height: var(--leading-snug); }
  @media (max-width: 639px) { .pn { grid-template-columns: 1fr; } .pn__gap { display: none; } }
</style>
