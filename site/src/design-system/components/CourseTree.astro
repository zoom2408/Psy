---
// Sidebar cây môn/bài. Hai cấp: nhóm (có thể thu gọn) và mục.
// States: group mở/đóng (chevron xoay), item hover (dịch phải), focus, current (thanh nhấn trượt vào), empty.
import Icon from './Icon.astro';
interface Item { title: string; href: string; current?: boolean; done?: boolean }
interface Group { title: string; href?: string; items?: Item[]; open?: boolean }
interface Props { groups: Group[]; label?: string; emptyText?: string; currentPath?: string }
const { groups, label = 'Mục lục môn học', emptyText = 'Chưa có bài học nào.', currentPath = Astro.url.pathname } = Astro.props;
const isCurrent = (i: Item) => i.current ?? i.href === currentPath;
---
<nav class="ctree" aria-label={label}>
  {groups.length === 0 ? (
    <p class="ctree__empty"><Icon name="layers" size={18} /> {emptyText}</p>
  ) : (
    <ul role="list" class="ctree__groups">
      {groups.map((g) => {
        const open = g.open ?? (g.items ?? []).some(isCurrent);
        return (
          <li>
            <details class="ctree__group" open={open}>
              <summary class="ctree__summary">
                <Icon name="chevron-right" size={16} class="ctree__chev" />
                <span>{g.title}</span>
                {g.items && <span class="ctree__count">{g.items.length}</span>}
              </summary>
              <ul role="list" class="ctree__items">
                {(g.items ?? []).map((it) => (
                  <li>
                    <a class:list={['ctree__link', isCurrent(it) && 'is-current', it.done && 'is-done']} href={it.href} aria-current={isCurrent(it) ? 'page' : undefined}>
                      <span class="ctree__label">{it.title}</span>
                      {it.done && <Icon name="check" size={14} class="ctree__done" />}
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          </li>
        );
      })}
    </ul>
  )}
</nav>

<style is:global>
  .ctree { font-family: var(--font-sans); font-size: var(--text-sm); }
  .ctree__groups { display: grid; gap: var(--space-1); margin: 0; padding: 0; }
  .ctree__summary {
    display: flex; align-items: center; gap: var(--space-2); padding: var(--space-2) var(--space-3);
    list-style: none; cursor: pointer; border-radius: var(--radius-md); font-weight: var(--weight-semibold); color: var(--color-text-primary);
    transition: background-color var(--duration-fast), transform var(--duration-fast) var(--ease-spring);
  }
  .ctree__summary::-webkit-details-marker { display: none; }
  .ctree__summary:hover { background: var(--color-bg-subtle); }
  .ctree__summary:active { transform: scale(0.98); }
  .ctree__summary:focus-visible { outline: 2px solid var(--accent-solid); outline-offset: -2px; }
  .ctree__chev { flex: none; color: var(--color-text-muted); transition: transform var(--duration-base) var(--ease-spring); }
  .ctree__group[open] > .ctree__summary .ctree__chev { transform: rotate(90deg); }
  .ctree__count { margin-left: auto; padding: 0 0.45rem; font-size: var(--text-xs); font-weight: var(--weight-medium); color: var(--color-text-muted); background: var(--color-bg-subtle); border-radius: var(--radius-pill); }

  .ctree__items { margin: var(--space-1) 0 var(--space-2) var(--space-4); padding: 0 0 0 var(--space-3); border-left: 1px solid var(--color-border-default); display: grid; gap: 2px; }
  .ctree__group[open] > .ctree__items { animation: ctree-open var(--duration-base) var(--ease-enter); }
  @keyframes ctree-open { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: none; } }

  .ctree__link {
    position: relative; display: flex; align-items: center; gap: var(--space-2); padding: 0.4rem var(--space-3);
    color: var(--color-text-secondary); text-decoration: none; border-radius: var(--radius-md); line-height: var(--leading-snug);
    transition: background-color var(--duration-fast), color var(--duration-fast), padding var(--duration-base) var(--ease-spring);
  }
  .ctree__link:hover { background: var(--color-bg-subtle); color: var(--color-text-primary); padding-left: calc(var(--space-3) + 3px); }
  .ctree__link:active { background: var(--color-bg-sunken); }
  .ctree__link::before {
    content: ''; position: absolute; left: calc(-1 * var(--space-3) - 1px); top: 18%; bottom: 18%; width: 3px; border-radius: 2px;
    background: var(--accent-solid); transform: scaleY(0); transition: transform var(--duration-base) var(--ease-spring);
  }
  .ctree__link.is-current { background: var(--accent-tint); color: var(--accent-text); font-weight: var(--weight-semibold); }
  .ctree__link.is-current::before { transform: scaleY(1); }
  .ctree__label { flex: 1; min-width: 0; }
  .ctree__done { color: var(--success-solid); flex: none; }
  .ctree__link.is-done:not(.is-current) { color: var(--color-text-muted); }

  .ctree__empty { display: flex; align-items: center; gap: var(--space-2); padding: var(--space-4); color: var(--color-text-muted); background: var(--color-bg-subtle); border: 1px dashed var(--color-border-default); border-radius: var(--radius-md); }
</style>
