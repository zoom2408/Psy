---
// Quiz 1 đáp án đúng. Dùng radio gốc nên bàn phím và screen reader hoạt động sẵn.
// States: idle, option hover, option focus, selected, checked-correct, checked-wrong (lắc), explanation mở, retry.
// `state` (idle|selected|correct|wrong) chỉ dùng để render sẵn trong catalog.
import Button from './Button.astro';
import Icon from './Icon.astro';
interface Props {
  question: string;
  options: { text: string; correct?: boolean }[];
  explanation?: string;
  number?: number;
  state?: 'idle' | 'selected' | 'correct' | 'wrong';
  picked?: number;
}
const { question, options, explanation, number, state = 'idle', picked } = Astro.props;
const hash = [...question].reduce((h, ch) => (h * 31 + ch.charCodeAt(0)) >>> 0, 7).toString(36);
const name = `q-${hash}`;
const answered = state === 'correct' || state === 'wrong';
const correctIdx = options.findIndex((o) => o.correct);
const chosen = picked ?? (state === 'correct' ? correctIdx : state === 'wrong' ? options.findIndex((o) => !o.correct) : state === 'selected' ? 0 : -1);
---
<psy-quiz class="quiz" data-state={state} data-reveal>
  <fieldset class="quiz__fieldset" disabled={answered}>
    <legend class="quiz__q">
      {number && <span class="quiz__num">Câu {number}</span>}
      <span>{question}</span>
    </legend>
    <div class="quiz__options">
      {options.map((o, i) => (
        <label class:list={['quiz__opt', answered && o.correct && 'is-correct', answered && !o.correct && i === chosen && 'is-wrong']}>
          <input type="radio" name={name} value={i} data-correct={o.correct ? 'true' : 'false'} checked={i === chosen} />
          <span class="quiz__marker" aria-hidden="true"><span class="quiz__dot"></span></span>
          <span class="quiz__text">{o.text}</span>
          <span class="quiz__verdict" aria-hidden="true">
            <span class="quiz__ico quiz__ico--ok"><Icon name="check" size={16} /></span>
            <span class="quiz__ico quiz__ico--no"><Icon name="x" size={16} /></span>
          </span>
        </label>
      ))}
    </div>
  </fieldset>
  <div class="quiz__bar">
    <Button size="sm" disabled={state === 'idle'} data-quiz-check>{answered ? 'Làm lại' : 'Kiểm tra'}</Button>
    <p class="quiz__feedback" role="status" aria-live="polite">{state === 'correct' ? 'Chính xác!' : state === 'wrong' ? 'Chưa đúng. Đáp án đúng được tô màu xanh.' : ''}</p>
  </div>
  {explanation && (
    <div class="quiz__explain" data-open={answered ? 'true' : 'false'}>
      <div class="quiz__explain-inner"><p><strong>Giải thích.</strong> {explanation}</p></div>
    </div>
  )}
</psy-quiz>

<style is:global>
  .quiz {
    position: relative; display: block; max-width: var(--layout-measure); margin-block: var(--space-5);
    padding: var(--space-5); background: var(--color-bg-surface); border: 1px solid var(--color-border-default); border-radius: var(--radius-xl);
    box-shadow: var(--shadow-sm); transition: box-shadow var(--duration-base), border-color var(--duration-base);
  }
  .quiz:hover { box-shadow: var(--shadow-md); }
  .quiz[data-state="correct"] { border-color: var(--success-border); }
  .quiz[data-state="wrong"] { border-color: var(--danger-border); }
  .quiz.is-shaking { animation: quiz-shake 420ms var(--ease-standard); }
  @keyframes quiz-shake { 15% { transform: translateX(-7px); } 35% { transform: translateX(6px); } 55% { transform: translateX(-4px); } 75% { transform: translateX(2px); } }

  .quiz__fieldset { min-width: 0; padding: 0; border: 0; }
  .quiz__q { display: flex; flex-direction: column; gap: var(--space-1); margin-bottom: var(--space-4); padding: 0; font-family: var(--font-serif); font-size: var(--text-md); font-weight: var(--weight-semibold); line-height: var(--leading-snug); }
  .quiz__num { font-family: var(--font-sans); font-size: var(--text-xs); font-weight: var(--weight-bold); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--accent-text); }

  .quiz__options { display: grid; gap: var(--space-2); }
  .quiz__opt {
    position: relative; display: flex; align-items: center; gap: var(--space-3); padding: var(--space-3) var(--space-4);
    background: var(--color-bg-page); border: 1.5px solid var(--color-border-default); border-radius: var(--radius-lg);
    cursor: pointer; font-size: var(--text-base); -webkit-tap-highlight-color: transparent;
    transition: transform var(--duration-fast) var(--ease-spring), border-color var(--duration-fast), background-color var(--duration-fast), box-shadow var(--duration-fast);
  }
  .quiz__opt input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: inherit; }
  .quiz__opt:hover, .quiz__opt.is-hover { border-color: var(--accent-solid); background: var(--accent-tint); transform: translateX(3px); }
  .quiz__opt:active, .quiz__opt.is-active { transform: scale(0.985); }
  .quiz__opt:has(input:focus-visible), .quiz__opt.is-focus { outline: 2px solid var(--accent-solid); outline-offset: 2px; }
  .quiz__opt:has(input:checked) { border-color: var(--accent-solid); background: var(--accent-tint-strong); }

  .quiz__marker { flex: none; display: grid; place-items: center; width: 1.25rem; height: 1.25rem; border-radius: 50%; border: 2px solid var(--color-border-strong); transition: border-color var(--duration-fast), background-color var(--duration-fast); }
  .quiz__dot { width: 0.6rem; height: 0.6rem; border-radius: 50%; background: var(--accent-solid); transform: scale(0); transition: transform var(--duration-base) var(--ease-spring); }
  .quiz__opt:has(input:checked) .quiz__marker { border-color: var(--accent-solid); }
  .quiz__opt:has(input:checked) .quiz__dot { transform: scale(1); }
  .quiz__text { flex: 1; min-width: 0; }

  .quiz__verdict { display: grid; width: 1.5rem; height: 1.5rem; }
  .quiz__ico { grid-area: 1 / 1; display: grid; place-items: center; border-radius: 50%; transform: scale(0); opacity: 0; transition: transform var(--duration-slow) var(--ease-spring), opacity var(--duration-fast); }
  .quiz__ico svg { stroke-dasharray: 26; stroke-dashoffset: 26; }

  /* Sau khi kiểm tra */
  .quiz .quiz__opt.is-correct { border-color: var(--success-solid); background: var(--success-tint-strong); transform: none; }
  .quiz .quiz__opt.is-correct .quiz__ico--ok { background: var(--success-solid); color: var(--success-on-solid); transform: scale(1); opacity: 1; }
  .quiz .quiz__opt.is-correct .quiz__ico--ok svg { animation: quiz-draw 420ms 120ms var(--ease-standard) forwards; }
  .quiz .quiz__opt.is-wrong { border-color: var(--danger-solid); background: var(--danger-tint-strong); transform: none; }
  .quiz .quiz__opt.is-wrong .quiz__ico--no { background: var(--danger-solid); color: var(--danger-on-solid); transform: scale(1); opacity: 1; }
  .quiz .quiz__opt.is-wrong .quiz__ico--no svg { animation: quiz-draw 360ms 120ms var(--ease-standard) forwards; }
  .quiz .quiz__opt.is-correct .quiz__marker, .quiz .quiz__opt.is-wrong .quiz__marker { visibility: hidden; }
  @keyframes quiz-draw { to { stroke-dashoffset: 0; } }
  .quiz__fieldset:disabled .quiz__opt { cursor: default; }
  .quiz__fieldset:disabled .quiz__opt:not(.is-correct):not(.is-wrong) { opacity: 0.6; transform: none; border-color: var(--color-border-subtle); background: var(--color-bg-page); }

  .quiz__bar { display: flex; align-items: center; gap: var(--space-4); margin-top: var(--space-4); min-height: 2rem; }
  .quiz__feedback { font-size: var(--text-sm); font-weight: var(--weight-semibold); }
  .quiz[data-state="correct"] .quiz__feedback { color: var(--success-text); animation: quiz-pop var(--duration-slow) var(--ease-spring); }
  .quiz[data-state="wrong"] .quiz__feedback { color: var(--danger-text); }
  @keyframes quiz-pop { from { transform: scale(0.85); opacity: 0; } to { transform: none; opacity: 1; } }

  /* Giải thích: mở bằng grid-template-rows */
  .quiz__explain { display: grid; grid-template-rows: 0fr; transition: grid-template-rows var(--duration-slow) var(--ease-standard), margin var(--duration-slow); }
  .quiz__explain[data-open="true"] { grid-template-rows: 1fr; margin-top: var(--space-4); }
  .quiz__explain-inner { overflow: hidden; }
  .quiz__explain-inner p { padding: var(--space-3) var(--space-4); background: var(--color-bg-subtle); border-radius: var(--radius-md); border-left: 3px solid var(--accent-solid); font-family: var(--font-serif); font-size: var(--text-base); line-height: var(--leading-relaxed); }

  /* Pháo hoa nhỏ khi đúng */
  .quiz__burst { position: absolute; width: 8px; height: 8px; border-radius: 50%; pointer-events: none; background: var(--c, var(--success-solid)); animation: quiz-burst 700ms var(--ease-enter) forwards; z-index: 2; }
  @keyframes quiz-burst { from { transform: translate(0, 0) scale(1); opacity: 1; } to { transform: translate(var(--dx), var(--dy)) scale(0.2); opacity: 0; } }

  @media (prefers-reduced-motion: reduce) {
    .quiz__burst { display: none; }
    .quiz__ico svg { stroke-dashoffset: 0; }
  }
</style>

<script>
  import '../../scripts/quiz.ts';
</script>
