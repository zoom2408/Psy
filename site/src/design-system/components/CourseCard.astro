---
// CourseCard. accent theo môn. States: default, hover (nâng, vạch màu giãn, mũi tên trượt), focus, active, loading (skeleton), coming-soon (khóa).
import Icon from './Icon.astro';
interface Props {
  title?: string; code?: string; href?: string; accent?: 'teal' | 'violet' | 'amber' | 'rose' | 'blue' | 'green';
  description?: string; lessons?: number; year?: number; progress?: number;
  loading?: boolean; soon?: boolean;
}
const { title, code, href, accent = 'teal', description, lessons, year, progress, loading = false, soon = false } = Astro.props;
const Tag = href && !soon && !loading ? 'a' : 'div';
---
{loading ? (
  <div class="cc cc--loading" aria-hidden="true">
    <span class="cc__skel cc__skel--code"></span><span class="cc__skel cc__skel--title"></span><span class="cc__skel"></span><span class="cc__skel cc__skel--short"></span>
  </div>
) : (
  <Tag class:list={['cc', soon && 'cc--soon']} data-accent={accent} href={Tag === 'a' ? href : undefined} aria-disabled={soon ? 'true' : undefined} data-reveal>
    <span class="cc__strip" aria-hidden="true"></span>
    <span class="cc__top">
      {code && <span class="cc__code">{code}</span>}
      {soon ? <span class="cc__badge">Sắp có</span> : year && <span class="cc__year">Năm {year}</span>}
    </span>
    <span class="cc__title">{title}</span>
    {description && <span class="cc__desc">{description}</span>}
    <span class="cc__foot">
      {lessons !== undefined && <span class="cc__meta"><Icon name="book-open" size={14} /> {lessons} bài</span>}
      {typeof progress === 'number' && (
        <span class="cc__progress" role="progressbar" aria-label="Tiến độ" aria-valuenow={progress} aria-valuemin="0" aria-valuemax="100">
          <span style={`--p:${progress / 100}`}></span>
        </span>
      )}
      {!soon && <Icon name="arrow-right" size={18} class="cc__go" />}
    </span>
  </Tag>
)}

<style is:global>
  .cc {
    position: relative; display: flex; flex-direction: column; gap: var(--space-2); width: 100%; min-height: 11rem; padding: var(--space-5) var(--space-5) var(--space-4);
    overflow: hidden; background: var(--color-bg-surface); border: 1px solid var(--color-border-default); border-radius: var(--radius-xl);
    color: inherit; text-decoration: none; box-shadow: var(--shadow-sm); font-family: var(--font-sans);
    transition: transform var(--duration-base) var(--ease-spring), box-shadow var(--duration-base), border-color var(--duration-fast);
  }
  .cc__strip { position: absolute; inset: 0 0 auto 0; height: 4px; background: var(--accent-solid); transition: height var(--duration-base) var(--ease-spring); }
  a.cc:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); border-color: var(--accent-border); }
  a.cc:hover .cc__strip { height: 8px; }
  a.cc:active { transform: translateY(-1px) scale(0.985); box-shadow: var(--shadow-sm); transition-duration: var(--duration-instant); }
  a.cc:focus-visible { outline: 2px solid var(--accent-solid); outline-offset: 3px; border-radius: var(--radius-xl); }

  .cc__top { display: flex; justify-content: space-between; align-items: center; margin-top: var(--space-1); }
  .cc__code { font-size: var(--text-xs); font-weight: var(--weight-bold); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--accent-text); }
  .cc__year { font-size: var(--text-xs); color: var(--color-text-muted); }
  .cc__title { font-family: var(--font-serif); font-size: var(--text-xl); font-weight: var(--weight-semibold); line-height: var(--leading-snug); letter-spacing: var(--tracking-tight); }
  .cc__desc { font-size: var(--text-sm); color: var(--color-text-secondary); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .cc__foot { display: flex; align-items: center; gap: var(--space-3); margin-top: auto; padding-top: var(--space-3); }
  .cc__meta { display: inline-flex; align-items: center; gap: var(--space-1); font-size: var(--text-xs); color: var(--color-text-muted); }
  .cc__progress { flex: 1; height: 5px; border-radius: var(--radius-pill); background: var(--color-bg-sunken); overflow: hidden; }
  .cc__progress span { display: block; height: 100%; background: var(--accent-solid); transform-origin: left; transform: scaleX(var(--p)); border-radius: inherit; transition: transform var(--duration-slower) var(--ease-standard); }
  .cc__go { margin-left: auto; color: var(--accent-text); transition: transform var(--duration-base) var(--ease-spring); }
  a.cc:hover .cc__go { transform: translateX(5px); }

  .cc--soon { background: var(--color-bg-subtle); border-style: dashed; box-shadow: none; cursor: not-allowed; }
  .cc--soon .cc__strip { background: var(--color-border-strong); }
  .cc--soon .cc__title, .cc--soon .cc__desc, .cc--soon .cc__code { color: var(--color-text-muted); }
  .cc__badge { padding: 0.1rem 0.6rem; font-size: var(--text-xs); font-weight: var(--weight-medium); color: var(--color-text-muted); background: var(--color-bg-sunken); border-radius: var(--radius-pill); }

  .cc--loading { gap: var(--space-3); box-shadow: none; }
  .cc__skel { height: 0.9rem; border-radius: var(--radius-sm); background: linear-gradient(90deg, var(--color-bg-subtle) 25%, var(--color-bg-sunken) 50%, var(--color-bg-subtle) 75%); background-size: 200% 100%; animation: shimmer 1.4s linear infinite; }
  .cc__skel--code { width: 30%; height: 0.7rem; }
  .cc__skel--title { width: 75%; height: 1.4rem; }
  .cc__skel--short { width: 50%; }
</style>
