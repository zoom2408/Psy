---
// Breadcrumb. States: link default, hover (gạch chân vẽ ra), focus, current (không phải link).
import Icon from './Icon.astro';
interface Props { items: { label: string; href?: string }[] }
const { items } = Astro.props;
---
<nav class="crumbs" aria-label="Đường dẫn">
  <ol role="list">
    {items.map((it, i) => {
      const last = i === items.length - 1;
      return (
        <li>
          {last || !it.href ? <span class="crumbs__current" aria-current={last ? 'page' : undefined}>{it.label}</span> : <a class="crumbs__link" href={it.href}>{it.label}</a>}
          {!last && <Icon name="chevron-right" size={14} class="crumbs__sep" />}
        </li>
      );
    })}
  </ol>
</nav>

<style is:global>
  .crumbs { font-family: var(--font-sans); font-size: var(--text-sm); }
  .crumbs ol { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-1) var(--space-1); margin: 0; padding: 0; }
  .crumbs li { display: inline-flex; align-items: center; gap: var(--space-1); }
  .crumbs__link { position: relative; color: var(--color-text-muted); text-decoration: none; padding: 2px var(--space-1); border-radius: var(--radius-sm); transition: color var(--duration-fast); }
  .crumbs__link::after { content: ''; position: absolute; left: var(--space-1); right: var(--space-1); bottom: 0; height: 1px; background: currentColor; transform: scaleX(0); transform-origin: left; transition: transform var(--duration-base) var(--ease-standard); }
  .crumbs__link:hover { color: var(--accent-text); }
  .crumbs__link:hover::after, .crumbs__link:focus-visible::after { transform: scaleX(1); }
  .crumbs__link:active { color: var(--accent-solid-hover); }
  .crumbs__current { color: var(--color-text-primary); font-weight: var(--weight-medium); padding: 2px var(--space-1); }
  .crumbs__sep { color: var(--color-border-strong); flex: none; }
</style>
