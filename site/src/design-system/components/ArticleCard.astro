---
// ArticleCard kiểu Medium. variant: "row" (chữ trái, bìa nhỏ phải) | "featured" (bìa lớn trên).
// States: default, hover (tiêu đề đổi màu, bìa nghiêng nhẹ, mũi tên trượt), focus, active, draft (có nhãn).
import Icon from './Icon.astro';
import Tag from './Tag.astro';
interface Props { href: string; title: string; excerpt: string; date: string; minutes: number; tags?: string[]; course?: string; courseTitle?: string; draft?: boolean; variant?: 'row' | 'featured'; seed?: number }
const { href, title, excerpt, date, minutes, tags = [], course, courseTitle, draft = false, variant = 'row', seed = 0 } = Astro.props;
const mono = (courseTitle ?? title).trim().charAt(0).toUpperCase();
---
<article class:list={['ac', `ac--${variant}`]} data-course={course} data-reveal>
  <a class="ac__link" href={href}>
    <div class="ac__body">
      <p class="ac__meta">
        {courseTitle && <span class="ac__course">{courseTitle}</span>}
        <span>{date}</span><span aria-hidden="true">·</span><span>{minutes} phút đọc</span>
        {draft && <Tag size="sm" variant="warning">Bản nháp</Tag>}
      </p>
      <h3 class="ac__title">{title}</h3>
      <p class="ac__excerpt">{excerpt}</p>
      <p class="ac__foot">
        {tags.slice(0, 2).map((t) => <span class="ac__tag">{t}</span>)}
        <span class="ac__read">Đọc bài <Icon name="arrow-right" size={14} class="ac__go" /></span>
      </p>
    </div>
    <div class="ac__cover" style={`--s:${seed}`} aria-hidden="true"><span>{mono}</span></div>
  </a>
</article>

<style is:global>
  .ac { font-family: var(--font-sans); }
  .ac__link { display: flex; gap: var(--space-6); align-items: stretch; padding: var(--space-6) var(--space-2); color: inherit; text-decoration: none; border-radius: var(--radius-lg); border-bottom: 1px solid var(--color-border-subtle);
    transition: background-color var(--duration-fast), transform var(--duration-base) var(--ease-spring); }
  .ac__link:hover { background: color-mix(in srgb, var(--color-bg-subtle) 60%, transparent); }
  .ac__link:active { transform: scale(0.99); transition-duration: var(--duration-instant); }
  .ac__link:focus-visible { outline: 2px solid var(--accent-solid); outline-offset: 2px; }
  .ac__body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: var(--space-2); }
  .ac__meta { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2); font-size: var(--text-xs); color: var(--color-text-muted); }
  .ac__course { font-weight: var(--weight-bold); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--accent-text); }
  .ac__title { font-family: var(--font-serif); font-size: var(--text-xl); font-weight: var(--weight-bold); line-height: var(--leading-snug); letter-spacing: var(--tracking-tight); text-wrap: balance; transition: color var(--duration-fast); }
  .ac__link:hover .ac__title { color: var(--accent-text); }
  .ac__excerpt { font-family: var(--font-serif); color: var(--color-text-secondary); line-height: var(--leading-normal); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .ac__foot { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2); margin-top: auto; padding-top: var(--space-2); }
  .ac__tag { padding: 0.15rem 0.65rem; font-size: var(--text-xs); color: var(--color-text-secondary); background: var(--color-bg-sunken); border-radius: var(--radius-pill); }
  .ac__read { display: inline-flex; align-items: center; gap: var(--space-1); margin-left: auto; font-size: var(--text-sm); font-weight: var(--weight-medium); color: var(--accent-text); }
  .ac__go { transition: transform var(--duration-base) var(--ease-spring); }
  .ac__link:hover .ac__go { transform: translateX(4px); }

  /* Bìa tạo bằng CSS: chữ cái đầu trên nền hoa văn, mỗi bài một góc khác nhau */
  .ac__cover { flex: none; position: relative; overflow: hidden; display: grid; place-items: center; width: 9.5rem; min-height: 7rem; border-radius: var(--radius-lg);
    background: repeating-linear-gradient(calc(30deg + var(--s) * 25deg), var(--accent-tint) 0 14px, var(--accent-tint-strong) 14px 15px), var(--accent-tint);
    border: 1px solid var(--accent-border); transition: transform var(--duration-base) var(--ease-spring); }
  .ac__cover span { font-family: var(--font-serif); font-size: var(--text-4xl); font-weight: var(--weight-bold); color: var(--accent-text); }
  .ac__link:hover .ac__cover { transform: rotate(-2deg) scale(1.04); }

  .ac--featured .ac__link { flex-direction: column-reverse; gap: var(--space-5); padding: var(--space-5); background: var(--color-bg-surface); border: 1px solid var(--color-border-default); box-shadow: var(--shadow-sm); border-radius: var(--radius-xl); }
  .ac--featured .ac__link:hover { box-shadow: var(--shadow-lg); transform: translateY(-3px); }
  .ac--featured .ac__cover { width: 100%; min-height: 12rem; }
  .ac--featured .ac__title { font-size: var(--text-2xl); }

  @media (max-width: 639px) {
    .ac:not(.ac--featured) .ac__link { flex-direction: column-reverse; gap: var(--space-3); }
    .ac:not(.ac--featured) .ac__cover { width: 100%; min-height: 5rem; }
  }
  @media (prefers-reduced-motion: reduce) { .ac__link:hover .ac__cover { transform: none; } }
</style>
