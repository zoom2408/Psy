---
// Khung hiển thị mẫu cho trang catalog (không thuộc bộ component phát hành).
interface Props { label?: string; note?: string; wide?: boolean; tall?: boolean; theme?: 'light' | 'dark'; accent?: string }
const { label, note, wide = false, tall = false, theme, accent } = Astro.props;
---
<figure class:list={['spec', wide && 'spec--wide']}>
  {(label || note) && <figcaption class="spec__cap"><span class="spec__label">{label}</span>{note && <span class="spec__note">{note}</span>}</figcaption>}
  <div class:list={['spec__stage', tall && 'spec__stage--tall']} data-theme={theme} data-accent={accent}><slot /></div>
</figure>

<style is:global>
  .spec { margin: 0; min-width: 0; }
  .spec--wide { grid-column: 1 / -1; }
  .spec__cap { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-1) var(--space-3); margin-bottom: var(--space-2); font-family: var(--font-sans); }
  .spec__label { font-size: var(--text-xs); font-weight: var(--weight-bold); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--color-text-muted); }
  .spec__note { font-size: var(--text-xs); color: var(--color-text-muted); }
  .spec__stage { display: flex; flex-wrap: wrap; align-items: flex-start; gap: var(--space-4); padding: var(--space-5); background: var(--color-bg-page); color: var(--color-text-primary); border: 1px solid var(--color-border-subtle); border-radius: var(--radius-lg); }
  .spec__stage--tall { min-height: 18rem; }
  .spec__stage > .quiz, .spec__stage > .qset { flex: 1 1 100%; margin: 0; }
</style>
