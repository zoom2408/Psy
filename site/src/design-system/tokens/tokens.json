{
  "$description": "Psy design tokens. Nguồn duy nhất. Chạy `npm run tokens` để sinh tokens.css. Tham chiếu dạng {color.cream.50}. Semantic color là cặp [light, dark].",
  "color": {
    "white": "#FFFFFF",
    "cream": { "50": "#FBF8F3", "100": "#F5F0E6", "200": "#EAE3D3", "300": "#D9D0BB" },
    "ink": { "300": "#C9C3B5", "400": "#A39C8D", "500": "#7A7468", "600": "#5F5A51", "700": "#46423B", "900": "#1D1B18" },
    "night": { "600": "#46423A", "700": "#322F28", "800": "#25231E", "900": "#1B1A16", "950": "#14130F" },
    "teal": { "50": "#E8F5F3", "100": "#CBE9E4", "300": "#7CCDC3", "500": "#2A9D8F", "600": "#1E7D72", "700": "#165F57" },
    "violet": { "50": "#F3EFFB", "100": "#E4DAF6", "300": "#BBA6EB", "500": "#7C5CC4", "600": "#6745B0", "700": "#4F3590" },
    "amber": { "50": "#FDF3E1", "100": "#FAE3B8", "300": "#F2C063", "500": "#D98E04", "600": "#A06400", "700": "#7F4E00" },
    "rose": { "50": "#FCEDEF", "100": "#F8D3D8", "300": "#F29AA8", "500": "#D6455D", "600": "#B52F46", "700": "#8C2336" },
    "blue": { "50": "#EAF1FC", "100": "#D0E0F8", "300": "#8DB7F0", "500": "#3B7DD8", "600": "#2563B8", "700": "#1B4A8C" },
    "green": { "50": "#EAF6EC", "100": "#CDE8D2", "300": "#86CC98", "500": "#3E9B55", "600": "#2C7A40", "700": "#205C30" }
  },
  "accents": {
    "default": "teal",
    "list": ["teal", "violet", "amber", "rose", "blue", "green"],
    "status": { "success": "green", "danger": "rose", "warning": "amber", "info": "blue" }
  },
  "semantic": {
    "bg-page": ["{color.cream.50}", "{color.night.950}"],
    "bg-surface": ["{color.white}", "{color.night.900}"],
    "bg-subtle": ["{color.cream.100}", "{color.night.800}"],
    "bg-sunken": ["{color.cream.200}", "{color.night.700}"],
    "bg-overlay": ["rgb(29 27 24 / 0.4)", "rgb(0 0 0 / 0.6)"],
    "text-primary": ["{color.ink.900}", "{color.cream.100}"],
    "text-secondary": ["{color.ink.700}", "{color.cream.300}"],
    "text-muted": ["{color.ink.600}", "{color.ink.400}"],
    "text-disabled": ["{color.ink.400}", "{color.ink.500}"],
    "border-subtle": ["{color.cream.200}", "{color.night.700}"],
    "border-default": ["{color.cream.300}", "{color.night.600}"],
    "border-strong": ["{color.ink.400}", "{color.ink.500}"],
    "shadow-color": ["rgb(60 40 20 / 0.14)", "rgb(0 0 0 / 0.55)"]
  },
  "font": {
    "serif": "'Source Serif 4 Variable', Georgia, 'Times New Roman', serif",
    "sans": "'Be Vietnam Pro', system-ui, -apple-system, 'Segoe UI', sans-serif",
    "mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
  },
  "text": {
    "xs": "0.75rem",
    "sm": "0.875rem",
    "base": "1rem",
    "md": "1.125rem",
    "lg": "1.25rem",
    "xl": "1.5rem",
    "2xl": "clamp(1.625rem, 1.3rem + 1.2vw, 2rem)",
    "3xl": "clamp(1.875rem, 1.4rem + 1.8vw, 2.5rem)",
    "4xl": "clamp(2.25rem, 1.6rem + 2.6vw, 3.25rem)"
  },
  "leading": { "tight": "1.2", "snug": "1.35", "normal": "1.5", "relaxed": "1.7" },
  "weight": { "regular": "400", "medium": "500", "semibold": "600", "bold": "700" },
  "tracking": { "tight": "-0.015em", "normal": "0", "wide": "0.04em", "caps": "0.08em" },
  "space": {
    "0": "0", "1": "0.25rem", "2": "0.5rem", "3": "0.75rem", "4": "1rem", "5": "1.25rem",
    "6": "1.5rem", "8": "2rem", "10": "2.5rem", "12": "3rem", "16": "4rem", "20": "5rem", "24": "6rem"
  },
  "radius": { "xs": "2px", "sm": "4px", "md": "8px", "lg": "12px", "xl": "16px", "pill": "999px" },
  "shadow": {
    "sm": "0 1px 2px var(--shadow-color)",
    "md": "0 4px 12px -2px var(--shadow-color), 0 2px 4px -2px var(--shadow-color)",
    "lg": "0 16px 32px -8px var(--shadow-color), 0 4px 8px -4px var(--shadow-color)"
  },
  "duration": { "instant": "80ms", "fast": "140ms", "base": "220ms", "slow": "360ms", "slower": "560ms" },
  "ease": {
    "standard": "cubic-bezier(0.2, 0, 0, 1)",
    "enter": "cubic-bezier(0, 0, 0, 1)",
    "exit": "cubic-bezier(0.3, 0, 1, 1)",
    "spring": "cubic-bezier(0.34, 1.56, 0.64, 1)"
  },
  "layout": {
    "header-h": "3.5rem",
    "sidebar-w": "17rem",
    "toc-w": "14rem",
    "measure": "42.5rem",
    "container": "80rem",
    "gutter": "1rem"
  },
  "z": { "header": "50", "overlay": "55", "drawer": "60", "popover": "65", "toast": "70" },
  "breakpoint": { "sm": "640px", "md": "768px", "lg": "1024px", "xl": "1280px" }
}
